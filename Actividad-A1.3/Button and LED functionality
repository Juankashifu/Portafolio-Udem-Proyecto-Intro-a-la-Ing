// PIN DEFENITIONS
const int led[3]    = {2, 3, 4};   // LED pins
const int button[3] = {5, 6, 7};   // Buttons, button[] controls LED[]

int active = 0; // LED currently ON

void setup() {
  for (int i = 0; i < 3; i++) {
    pinMode(led[i], OUTPUT);
    pinMode(button[i], INPUT_PULLUP); // pressed = LOW
  }

  randomSeed(analogRead(A0));
  active = random(0, 3);
  digitalWrite(led[active], HIGH);
}

void loop() {
  // ONLY REACTS TO THE BUTTON FOR THE LIT LED
  if (digitalRead(button[active]) == LOW) {
    delay(50); // debounce
    if (digitalRead(button[active]) == LOW) {
      digitalWrite(led[active], LOW);   // turn off current LED
      active = random(0, 3);            // pick new LED randomly
      digitalWrite(led[active], HIGH);  // turn it on
      delay(200); // pause to avoid accidental double-press on new LED
    }
  }
}
